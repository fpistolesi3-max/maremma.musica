# Istanza online (Vercel). In locale non serve niente: senza queste variabili l'app usa .data/.

# Supabase: Project Settings → API. La service role vale solo sul server, mai nel browser.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Firma dei QR e delle sessioni: una stringa lunga e casuale (es. `openssl rand -base64 32`). Non cambiarla dopo.
MM_SEGRETO=

# Indirizzo pubblico, senza barra finale (nei link delle email). Es. https://maremmamusica.vercel.app
SITO_URL=

# 1 = account di prova, "Entra subito", /dev/posta e noindex. Solo sull'istanza di test.
MM_MODALITA_PROVA=1

# Protegge /api/cron/tavoli (promemoria e scadenza dei tavoli, una volta al giorno): stringa casuale.
CRON_SECRET=

# Pagamento dei tavoli con Stripe: il cliente paga la spesa minima sul sito e il tavolo si conferma da solo.
# Senza chiave, in sviluppo e con MM_MODALITA_PROVA=1, c'è la pagina di prova /dev/pagamento; sul sito vero i tavoli non si prenotano.
# Stripe: Developers → API keys (sk_test_… per le prove) e Webhooks → endpoint /api/pagamenti/stripe,
# evento checkout.session.completed (il segreto whsec_… va qui sotto).
# STRIPE_SECRET_KEY= STRIPE_WEBHOOK_SECRET=

# Email vere (facoltativo, vedi README)
# SMTP_HOST= SMTP_PORT= SMTP_USER= SMTP_PASS= EMAIL_MITTENTE=

# Wallet sul telefono (facoltativo, vedi README → Wallet). Ogni wallet si accende solo se ci sono TUTTE le sue variabili: altrimenti il pulsante non compare.
# Apple Wallet: Apple Developer Program, Pass Type ID, certificato, WWDR. Certificati e chiave sono i file PEM in base64 su una riga.
# APPLE_PASS_TYPE_ID=pass.it.maremmamusica.biglietto
# APPLE_TEAM_ID=
# APPLE_PASS_CERT_BASE64=
# APPLE_PASS_KEY_BASE64=
# APPLE_PASS_KEY_PASSWORD=
# APPLE_WWDR_CERT_BASE64=
# Google Wallet: Issuer ID della Google Pay & Wallet Console + email e chiave privata del service account (dal file JSON).
# GOOGLE_WALLET_ISSUER_ID=
# GOOGLE_WALLET_EMAIL=
# GOOGLE_WALLET_PRIVATE_KEY=
